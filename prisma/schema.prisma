generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ImageStatus {
  PENDING
  PROCESSING
  ACCEPTED
  REJECTED
}

model Image {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  filename        String
  originalUrl     String
  processedUrl    String?
  fileType        String
  fileSize        Int
  width           Int?
  height          Int?
  status          ImageStatus @default(PENDING)
  rejectionReason String?
  hash            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([hash])
  @@index([createdAt])
  @@map("images")
}
